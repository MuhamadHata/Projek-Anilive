# ==============================================================================
# Anilive Environment Configuration Template
# Salin file ini menjadi .env lalu sesuaikan dengan kredensial Anda:
#   copy .env.example .env
# Jalankan aplikasi menggunakan argumen:
#   flutter run --dart-define-from-file=.env
# ==============================================================================

# Supabase Credentials (Dapatkan dari Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Google OAuth Web Client ID (Dapatkan dari Google Cloud Console -> Credentials)
GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# LLM / AI RAG Search (Together AI / OpenAI Compatible API)
LLM_API_KEY=your-together-ai-api-key
LLM_BASE_URL=https://api.together.xyz/v1
LLM_MODEL=meta-llama/Llama-3-8b-chat-hf

# Giphy API Key (Untuk fitur pencarian GIF banner profil)
GIPHY_API_KEY=your-giphy-api-key
